// Schema Prisma - Blog AdSense Builder
// SQLite par defaut. Pour Postgres: changer provider en "postgresql".

generator client {
  provider      = "prisma-client-js"
  // Binaires requis pour hebergement Linux (cPanel / Namecheap)
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Administrateur unique du blog (extensible a plusieurs)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Article de blog. Le contenu visuel est stocke en JSON (donnees Puck).
model Article {
  id                 String    @id @default(cuid())
  slug               String    @unique
  locale             String    @default("fr")
  translationGroupId String? // relie les traductions d'un meme article
  title              String
  excerpt            String?
  status             String    @default("draft") // draft | published
  puckData           String    @default("{}") // JSON serialise (contenu de l'editeur)
  metaTitle          String?
  metaDescription    String?
  ogImage            String?
  coverMediaId       String?
  cover              Media?    @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               Tag[]     @relation("ArticleTags")
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([locale])
}

// Page libre (accueil, pages secondaires, pages legales). Routee par "path".
model Page {
  id              String   @id @default(cuid())
  path            String   @unique // ex: "/", "/a-propos", "/contact"
  locale          String   @default("fr")
  title           String
  isHome          Boolean  @default(false)
  status          String   @default("draft") // draft | published
  puckData        String   @default("{}")
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  showInNav       Boolean  @default(false)
  navOrder        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

// Fichier de la mediatheque (upload manuel ou genere par IA), reutilisable partout.
model Media {
  id        String    @id @default(cuid())
  filename  String
  url       String // chemin public servi par l'app, ex: /api/uploads/xxx.webp
  mime      String
  width     Int?
  height    Int?
  size      Int?
  alt       String?
  source    String    @default("upload") // upload | ai
  prompt    String? // prompt IA ayant genere l'image
  createdAt DateTime  @default(now())
  articles  Article[] @relation("ArticleCover")
}

// Reglages cle/valeur (theme, variantes navbar/footer, config AdSense, config OpenRouter, ...)
model Setting {
  key       String   @id
  value     String // JSON serialise
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]  @relation("ArticleTags")
}

// Vue de page (statistiques d'audience). Enregistree cote client.
model PageView {
  id        String   @id @default(cuid())
  path      String
  type      String   @default("other") // article | page | other
  refId     String? // id de l'article ou de la page concerne
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([type, refId])
}
