# Copie ce fichier vers .env (local) ou configure les variables dans cPanel > Setup Node.js App.

# --- Base de donnees ---
# Local (dev) : SQLite
DATABASE_URL="file:./dev.db"

# Production cPanel (SQLite) — chemin ABSOLU hors public_html, ex:
# DATABASE_URL="file:/home/VOTRE_USER/blogdata/prod.db"

# Production cPanel (MySQL) — cree la base dans cPanel > MySQL Databases, puis:
# DATABASE_URL="mysql://VOTRE_USER_bloguser:motdepasse@localhost:3306/VOTRE_USER_blogdb"
# (Change aussi provider en "mysql" dans prisma/schema.prisma avant de migrer)

# --- Securite ---
# Secret de session (min 32 caracteres). Genere via: openssl rand -base64 48
AUTH_SECRET="change-me-with-a-long-random-value"

# --- Compte admin initial (utilise uniquement par le seed, une seule fois) ---
ADMIN_EMAIL="admin@monblog.com"
ADMIN_PASSWORD="change-me"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production: NEXT_PUBLIC_SITE_URL="https://votre-domaine.com"

# --- cPanel (injectes automatiquement par Setup Node.js App) ---
# NODE_ENV=production
# PORT=XXXX
