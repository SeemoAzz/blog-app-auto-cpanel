{
  "name": "blogsite",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-build.mjs",
    "build:full": "node scripts/run-build.mjs --full",
    "start": "next start",
    "lint": "eslint",
    "prestart": "prisma generate --schema=./prisma/schema.prisma && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "cpanel:deploy": "bash scripts/cpanel-deploy.sh"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@puckeditor/core": "^0.22.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "prisma": "^6.19.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
